# Leave empty to use the explicitly labeled local demo (no AI calls).
OPENAI_API_KEY=
STUDIO_MODE=auto
PORT=4320
AGENT_MODEL=gpt-6.1-sol
IMAGE_MODEL=gpt-image-2.5-sunburst
# Initial defaults only; saved debug-panel settings take precedence.
# Optional conversation/reference-image provider. Defaults to the Responses adapter;
# choose Chat Completions in the debug panel if required by the gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional separate image provider. Set both values together; otherwise images
# reuse the conversation provider. Must support Images generation + editing.
# IMAGE_BASE_URL=https://api.apiyi.com/v1
# IMAGE_API_KEY=your-apiyi-key
# Optional extra directory containing <skill-name>/SKILL.md
# SKILLS_DIR=/absolute/path/to/your/skills
# STUDIO_DATA_DIR=/absolute/path/to/data
MAX_IMAGES_PER_TURN=2
SANDBOX_MODE=local
# Alternative: reuse an existing credentials file instead of copying secrets.
# STUDIO_CREDENTIALS_FILE=~/.config/codex-imagegen/ffka.env
