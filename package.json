{
  "name": "agent-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "check": "node --check server/index.js && node --check server/agent.js && node --check public/app.js && node --check public/debug.js && node --test tests/*.test.js",
    "test:ui": "node tests/browser.mjs"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "express": "^5.1.0",
    "openai": "^6.40.0",
    "sharp": "^0.35.4",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
