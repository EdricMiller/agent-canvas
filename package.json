{
  "name": "agent-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "check": "node --check server/index.js && node --check server/agent.js && node --check public/app.js && node --check public/debug.js && node --test tests/*.test.js",
    "test:ui": "node tests/browser.mjs",
    "test:design": "node --test tests/design.test.js tests/design-contracts.test.js tests/design-operations.test.js tests/design-agent.test.js tests/design-turns.test.js tests/design-pages.test.js tests/design-pages-api.test.js",
    "test:design-ui": "node tests/browser-design.mjs && node tests/browser-design-ai.mjs",
    "verify:design-export": "node scripts/verify-design-export.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start:legacy": "node --env-file-if-exists=.env server/index.js --legacy",
    "test:workspace-ui": "node tests/browser-workspace.mjs",
    "test:pages-ui": "node tests/browser-pages.mjs",
    "test:print": "node --test tests/design-print.test.js tests/design-print-api.test.js tests/design-bleed.test.js",
    "test:print-ui": "node tests/browser-print.mjs",
    "test:bleed-ui": "node tests/browser-bleed.mjs",
    "test:editor": "node --test tests/design-editor.test.js",
    "test:editor-ui": "node tests/browser-editor.mjs",
    "test:autosave-ui": "node tests/browser-autosave.mjs",
    "test:objects": "node --test tests/design-objects.test.js tests/design-operations.test.js",
    "test:objects-ui": "node tests/browser-objects.mjs",
    "test:image-target": "node --test tests/image-target.test.js tests/image-target-api.test.js tests/image-generation.test.js tests/image-generation-api.test.js",
    "test:image-target-ui": "node tests/browser-image-target.mjs",
    "test:recolor": "node --test tests/image-colors.test.js",
    "test:compose": "node --test tests/image-compose.test.js tests/image-compose-api.test.js",
    "test:recolor-ui": "node tests/browser-recolor.mjs",
    "test:logo": "node --test tests/logo.test.js tests/logo-api.test.js",
    "test:logo-ui": "node tests/browser-logo.mjs",
    "test:vector": "node --test tests/vector.test.js tests/vector-api.test.js",
    "test:compose-ui": "node tests/browser-compose.mjs"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "express": "^5.1.0",
    "next": "^16.4.5",
    "openai": "^6.40.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.4",
    "svgpath": "2.6.0",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^5.9.3"
  }
}
